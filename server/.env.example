PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/greenfield_cms

# Use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Password given to students/teachers created by an admin when no password is typed in the form
DEFAULT_PASSWORD=ChangeMe@123
